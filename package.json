{
  "name": "ember",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ember/worker --filter @ember/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @ember/e2e test:e2e",
    "test:features": "pnpm --filter @ember/e2e test:e2e --project features",
    "test:mobile": "pnpm --filter @ember/e2e test:e2e --project 'mobile *'",
    "parity": "pnpm --filter @ember/parity regenerate",
    "deploy": "pnpm build && pnpm --filter @ember/worker run deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
