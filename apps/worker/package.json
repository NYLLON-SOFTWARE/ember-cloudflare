{
  "name": "@ember/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p . && tsc -p scripts && tsc -p scripts/tsconfig.test.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime false",
    "d1:migrate:local": "wrangler d1 migrations apply ember --local"
  },
  "dependencies": {
    "@ember/protocol": "workspace:*",
    "@ember/richtext": "workspace:*",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@ember/parity": "workspace:*",
    "@ember/web": "workspace:*",
    "@types/node": "^26.6.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
