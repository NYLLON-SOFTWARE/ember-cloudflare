{
  "name": "@ember/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "cf-typegen": "wrangler types --include-runtime false",
    "d1:migrate:local": "wrangler d1 migrations apply ember --local"
  },
  "dependencies": {
    "@ember/protocol": "workspace:*"
  },
  "devDependencies": {
    "@ember/web": "workspace:*",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
