{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ember",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Link previews fetch pages people name: this sends those fetches out over the public Internet even
  // when they name a host in this Worker's own zone, rather than straight to its origin.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // `enabled` alone turns on logs; traces time each fetch, RPC and Durable Object SQL statement.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Lets production CPU and heap profiles and exception stacks name our source files.
  "upload_source_maps": true,

  // The built React app. Everything but its static files goes to the Worker first, page loads
  // included, so each answer carries ember-rust's headers and old browsers get the upgrade page;
  // the Worker answers /api/*, /up, the setup and join pages, the web app manifest
  // (/webmanifest.json) and QR codes (/qr_code/<id>) itself, and fetches the app's page for the
  // rest.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/browsers/*", "!/logos/*", "!/shortcuts/*", "!/ember-icon.png"]
  },

  // One ChatRoom object per room, which owns its sockets, presence and (by default) its messages,
  // one Workspace object for what the rooms share, and short-lived PasswordHasher and Unfurler
  // objects, which have the CPU time a password's hash and a link's preview take.
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" },
      { "name": "UNFURLER", "class_name": "Unfurler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace"] },
    { "tag": "v3", "new_sqlite_classes": ["PasswordHasher"] },
    { "tag": "v4", "new_sqlite_classes": ["Unfurler"] }
  ],

  "vars": {
    // "do-sqlite" keeps each room's messages in its Durable Object's SQLite storage.
    // "d1" writes them to the shared D1 database below instead.
    "STORAGE_BACKEND": "do-sqlite"
  }

  // To use D1, create a database (`wrangler d1 create ember`), paste its id here,
  // set STORAGE_BACKEND to "d1", and apply migrations/ with `pnpm d1:migrate:local`.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "ember", "database_id": "<your-database-id>", "migrations_dir": "migrations" }
  // ]
}
