{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ember",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // `enabled` alone turns on logs; traces time each fetch, RPC and Durable Object SQL statement.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  // Lets production CPU and heap profiles and exception stacks name our source files.
  "upload_source_maps": true,

  // The Worker serves the built React app and answers /api/*, the setup pages (/first_run...) and the
  // join link's page (/join/<code>) itself.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/first_run*", "/join/*"]
  },

  // One ChatRoom object per room, which owns its sockets, presence and (by default) its messages,
  // one Workspace object for what the rooms share, and short-lived PasswordHasher objects, which
  // have the CPU time a password's hash takes.
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "WORKSPACE", "class_name": "Workspace" },
      { "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace"] },
    { "tag": "v3", "new_sqlite_classes": ["PasswordHasher"] }
  ],

  "vars": {
    // "do-sqlite" keeps each room's messages in its Durable Object's SQLite storage.
    // "d1" writes them to the shared D1 database below instead.
    "STORAGE_BACKEND": "do-sqlite"
  }

  // To use D1, create a database (`wrangler d1 create ember`), paste its id here,
  // set STORAGE_BACKEND to "d1", and apply migrations/ with `pnpm d1:migrate:local`.
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "ember", "database_id": "<your-database-id>", "migrations_dir": "migrations" }
  // ]
}
