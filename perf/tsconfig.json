{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Node runs these files directly by stripping their types, so stick to syntax it can erase.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    // DOM is for the functions that run inside the browser via page.evaluate.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src"]
}
